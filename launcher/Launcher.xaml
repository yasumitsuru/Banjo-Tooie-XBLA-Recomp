<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Banjo-Tooie PT-BR Recompiled" Width="1220" Height="900" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#17110B" Foreground="#F7EEDF" FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
 <!-- Layout e estilos adaptados do configurador do MC_LA_Recompiled (Roberto Araujo, GPL-3.0-or-later),
      via a primeira adaptação do projeto irmão W:\Decomp\Banjo, com as cores do Banjo-Tooie. -->
 <Window.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4A3622" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#2A1E13"/><Setter Property="Foreground" Value="#F7EEDF"/><Setter Property="BorderBrush" Value="#4A3622"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFD27A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#F5B83D"/><Setter Property="Foreground" Value="#1E1206"/><Setter Property="BorderBrush" Value="#F5B83D"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#140E08"/><Setter Property="Foreground" Value="#F7EEDF"/><Setter Property="BorderBrush" Value="#4A3622"/><Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="#F5B83D"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F7EEDF"/><Setter Property="Background" Value="#241910"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#4A3420"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F7EEDF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Box" Background="#1A120B" BorderBrush="#4A3622" BorderThickness="1" CornerRadius="6"><Grid><ContentPresenter Margin="12,9,32,9" TextElement.Foreground="#F7EEDF" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"/><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#F5B83D"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#241910" BorderBrush="#4A3622" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="350"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F7EEDF"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Background="Transparent"><Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#4A3622"><Border x:Name="Thumb" Width="18" Height="18" Margin="3" CornerRadius="9" Background="#CDB89B" HorizontalAlignment="Left"/></Border><ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#F5B83D"/><Setter TargetName="Thumb" Property="Background" Value="#2A1806"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="#BFA98C"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="BG" CornerRadius="8" Background="Transparent" Padding="17,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{TemplateBinding Tag}" FontSize="16"/><ContentPresenter Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="BG" Property="Background" Value="#33230F"/><Setter Property="Foreground" Value="#FFD27A"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BG" Property="Background" Value="#261A0E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#221810"/><Setter Property="BorderBrush" Value="#3A2A1A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="29"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#BFA98C"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
 </Window.Resources>
 <Grid x:Name="RootGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#120D08" BorderBrush="#2E2114" BorderThickness="0,0,1,0"><DockPanel Margin="16,24">
  <StackPanel DockPanel.Dock="Top" Margin="8,0,0,26" Orientation="Horizontal"><Image x:Name="SideLogo" Height="54" Width="54" Stretch="Uniform"/><StackPanel Margin="12,4,0,0"><TextBlock Text="BANJO-TOOIE" FontWeight="Black" FontSize="14"/><TextBlock Text="PT-BR RECOMPILED" Foreground="#F5B83D" FontSize="10" FontWeight="Bold" Margin="1,5,0,0"/></StackPanel></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="11,0,0,0"><TextBlock Text="IDIOMA · LANGUAGE" Foreground="#FFD27A" FontSize="10" FontWeight="Bold"/><ComboBox x:Name="LanguageBox" Margin="0,8,8,4" FontSize="12" AutomationProperties.Name="Idioma / Language"><ComboBoxItem Content="Português (Brasil)" Tag="pt"/><ComboBoxItem Content="English" Tag="en"/></ComboBox><TextBlock x:Name="VersionText" Text="Launcher portátil" Margin="0,9,0,0" Foreground="#8F7A60" FontSize="11"/><TextBlock Text="Port nativo · ReXGlue · sem emulador" Margin="0,5,0,0" Foreground="#8F7A60" FontSize="10"/></StackPanel>
  <StackPanel x:Name="Navigation"><RadioButton x:Name="NavHome" Content="Jogar" Tag="▷" Style="{StaticResource Nav}" GroupName="Nav" IsChecked="True"/><RadioButton x:Name="NavGraphics" Content="Gráficos" Tag="☷" Style="{StaticResource Nav}" GroupName="Nav"/><RadioButton x:Name="NavControls" Content="Controles" Tag="◎" Style="{StaticResource Nav}" GroupName="Nav"/><RadioButton x:Name="NavGame" Content="Áudio e jogo" Tag="♪" Style="{StaticResource Nav}" GroupName="Nav"/><RadioButton x:Name="NavSaves" Content="Saves e backups" Tag="▣" Style="{StaticResource Nav}" GroupName="Nav"/><RadioButton x:Name="NavLogs" Content="Diagnóstico" Tag="≡" Style="{StaticResource Nav}" GroupName="Nav"/><RadioButton x:Name="NavCredits" Content="Créditos" Tag="◇" Style="{StaticResource Nav}" GroupName="Nav"/></StackPanel>
 </DockPanel></Border>
 <Grid Grid.Column="1" Margin="32,28,32,70">
  <Grid x:Name="PageHome"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="250"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*" MinWidth="270"/></Grid.ColumnDefinitions>
    <Border CornerRadius="14" ClipToBounds="True" Margin="0,0,18,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5A3A12" Offset="0"/><GradientStop Color="#2A1A0A" Offset="0.55"/><GradientStop Color="#123024" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Image x:Name="HeroArt" Stretch="UniformToFill" Opacity="0.85"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#10110B06" Offset="0"/><GradientStop Color="#F0110B06" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel VerticalAlignment="Bottom" Margin="23"><TextBlock Text="A AVENTURA CONTINUA" FontSize="34" FontWeight="Black"/><TextBlock Text="EM 4K A 60 FPS." FontSize="28" FontWeight="Black" Foreground="#FFD27A"/><TextBlock Text="Tradução PT-BR · Port nativo recompilado · Pasta 100% portátil" Margin="0,13,0,0" FontSize="11" Foreground="#E3D3BC"/></StackPanel></Grid></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel VerticalAlignment="Center"><TextBlock Text="PRONTO PARA A AVENTURA?" FontWeight="Bold" Foreground="#BFA98C" FontSize="11"/><TextBlock x:Name="InstallStatus" Text="Prepare o seu jogo" FontSize="22" FontWeight="Bold" Margin="0,12,0,12" TextWrapping="Wrap"/><Button x:Name="PlayButton" Content="JOGAR" Style="{StaticResource Primary}" FontSize="20" Padding="16,13" IsEnabled="False"/><TextBlock x:Name="HomeActionHint" Text="Escolha abaixo a pasta do seu Banjo-Tooie XBLA descompactado." Style="{StaticResource Hint}" FontSize="11" Margin="0,11,0,0"/></StackPanel></Border>
   </Grid>
   <TextBlock Grid.Row="1" Text="SEUS ARQUIVOS DO JOGO" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
   <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Pasta do Banjo-Tooie XBLA já descompactado (com default.xex e a pasta RAWFiles)" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <Grid Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="SourcePath" Margin="0,0,12,0"/><Button x:Name="BrowseSource" Content="Procurar pasta…" Grid.Column="1" Margin="0,0,12,0"/><Button x:Name="CheckSource" Content="Conferir" Grid.Column="2"/></Grid>
    <TextBlock x:Name="SourceCheck" Text="Use a sua própria cópia do jogo. Ela só é lida: nada nela é alterado, apagado ou enviado." Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,14"/>
    <CheckBox x:Name="CopyGame" Content="Copiar os arquivos do jogo para dentro desta pasta portátil (pasta jogo\)" IsChecked="True" Margin="0,0,0,8"/>
    <TextBlock Text="Ligado: a pasta portátil fica completa e pode ser levada para outro disco ou computador (cerca de 95 MB a mais). Desligado: o jogo é lido da pasta escolhida, que precisa continuar no mesmo lugar." Style="{StaticResource Hint}" FontSize="11" Margin="56,0,0,18"/>
    <WrapPanel><Button x:Name="PrepareButton" Content="PREPARAR MEU JOGO" Style="{StaticResource Primary}" Margin="0,0,12,0"/><Button x:Name="OpenRoot" Content="Abrir a pasta portátil"/></WrapPanel></StackPanel></Border>
   <Border x:Name="HomeInfoBox" Grid.Row="3" Background="#2A1D0D" CornerRadius="9" Padding="16" Margin="0,18,0,0"><TextBlock x:Name="HomeInfo" Text="O jogo é um programa do Windows recompilado a partir do código do Xbox 360 — não há emulador nem imagem de disco. A preparação confere os seus arquivos (a própria pré-checagem do jogo e o SHA-256 dos arquivos-chave), copia se você quiser e guarda tudo nesta pasta: saves, opções, registros e cache. Nada vai para o Registro do Windows e nada é baixado da internet." Style="{StaticResource Hint}" FontSize="12"/></Border>
  </Grid>
  <Grid x:Name="PageGraphics" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="GRÁFICOS" Style="{StaticResource Heading}"/><TextBlock Text="As mesmas opções do menu Configurações de PC do jogo (F1). Valem na próxima vez que o jogo abrir." Style="{StaticResource Hint}" Margin="0,0,0,22"/>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="PresetOriginal" AutomationProperties.Name="Perfil Original" HorizontalContentAlignment="Left" Margin="0,0,10,0"><StackPanel><TextBlock Text="ORIGINAL" FontWeight="Bold" Foreground="#FFD27A"/><TextBlock Text="30 FPS, imagem interna 720p,&#10;alcance e filtros do console." Foreground="#BFA98C" Margin="0,9,0,0" FontSize="11"/></StackPanel></Button>
    <Button x:Name="PresetBalanced" AutomationProperties.Name="Perfil Equilibrado" Grid.Column="1" HorizontalContentAlignment="Left" Margin="0,0,10,0"><StackPanel><TextBlock Text="EQUILIBRADO" FontWeight="Bold" Foreground="#FFD27A"/><TextBlock Text="60 FPS, imagem interna 1440p,&#10;FXAA e anisotrópica 8×." Foreground="#BFA98C" Margin="0,9,0,0" FontSize="11"/></StackPanel></Button>
    <Button x:Name="PresetMax" AutomationProperties.Name="Perfil 4K máximo" Grid.Column="2" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="4K MÁXIMO" FontWeight="Bold" Foreground="#FFD27A"/><TextBlock Text="Saída e imagem interna 4K a 60 FPS,&#10;MSAA 2×, anisotrópica 16×, alcance Longe." Foreground="#BFA98C" Margin="0,9,0,0" FontSize="11"/></StackPanel></Button></Grid>
   <TextBlock x:Name="PresetLabel" Text="Perfil: configurações atuais" Foreground="#FFD27A" Margin="0,0,0,16"/><StackPanel x:Name="GraphicsGroups"/>
   <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="SHADERS DA PLACA DE VÍDEO" FontWeight="Bold" Foreground="#F5B83D" Margin="0,0,0,12"/><TextBlock x:Name="ShaderStatus" Text="O cache de shaders desta pasta ainda está vazio." TextWrapping="Wrap"/><TextBlock Text="O jogo guarda na pasta cache\ cada shader que a placa já usou. Depois de trocar de placa ou de driver, preparar de novo evita travadinhas na primeira passagem por cada lugar." Style="{StaticResource Hint}" FontSize="11" Margin="0,10,0,14"/><Button x:Name="PrepareShaders" Content="Preparar shaders guardados agora" HorizontalAlignment="Left"/></StackPanel></Border>
   </StackPanel></ScrollViewer><WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="DefaultsGraphics" Content="Restaurar padrões" Margin="0,0,12,0"/><Button x:Name="ApplyGraphics" Content="SALVAR CONFIGURAÇÕES" Style="{StaticResource Primary}"/></WrapPanel></Grid>
  <Grid x:Name="PageControls" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="CONTROLES" Style="{StaticResource Heading}"/><TextBlock Text="Teclado e mouse funcionam sempre; um controle de Xbox (ou compatível com XInput) conectado também. Os botões do controle seguem o layout do Xbox 360 e não são remapeados; as teclas do teclado sim. Também dá para trocar as teclas no menu F1 do jogo, apertando a tecla nova." Style="{StaticResource Hint}" Margin="0,0,0,22"/>
   <StackPanel x:Name="ControlGroups"/>
   </StackPanel></ScrollViewer><WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="DefaultsControls" Content="Restaurar padrões" Margin="0,0,12,0"/><Button x:Name="ApplyControls" Content="SALVAR CONFIGURAÇÕES" Style="{StaticResource Primary}"/></WrapPanel></Grid>
  <Grid x:Name="PageGame" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="ÁUDIO E JOGO" Style="{StaticResource Heading}"/><TextBlock Text="Música e efeitos sonoros têm volumes separados no menu de opções do próprio jogo; aqui ficam o volume geral do PC e as melhorias de qualidade de vida do port." Style="{StaticResource Hint}" Margin="0,0,0,22"/>
   <StackPanel x:Name="GameGroups"/>
   </StackPanel></ScrollViewer><WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="DefaultsGame" Content="Restaurar padrões" Margin="0,0,12,0"/><Button x:Name="ApplyGame" Content="SALVAR CONFIGURAÇÕES" Style="{StaticResource Primary}"/></WrapPanel></Grid>
  <ScrollViewer x:Name="PageSaves" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="SAVES E BACKUPS" Style="{StaticResource Heading}"/><TextBlock Text="Saves, backups automáticos, opções de PC e registros ficam na pasta dados\ desta pasta portátil. Levar a pasta inteira leva também o seu progresso." Style="{StaticResource Hint}" Margin="0,0,0,24"/>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SEU SAVE" FontWeight="Bold" Foreground="#F5B83D"/><TextBlock x:Name="SavePath" TextWrapping="Wrap" Margin="0,15,0,10"/><TextBlock x:Name="SaveSummary" Style="{StaticResource Hint}"/><WrapPanel Margin="0,19,0,0"><Button x:Name="OpenSaves" Content="Abrir pasta dos dados" Margin="0,0,12,8"/><Button x:Name="OpenBackups" Content="Abrir backups automáticos" Margin="0,0,12,8"/><Button x:Name="BackupSaves" Content="Exportar backup .zip" Style="{StaticResource Primary}" Margin="0,0,12,8"/><Button x:Name="ImportZip" Content="Importar backup .zip" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Importar um .zip substitui os dados atuais; antes disso eles são exportados para backups-launcher\ (nada é apagado). Para voltar a um backup automático, use F1 → SAVES dentro do jogo: o jogo confere o arquivo antes de restaurar." Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="SAVE DO JOGO INSTALADO FORA DESTA PASTA" FontWeight="Bold" Foreground="#F5B83D"/><TextBlock x:Name="DocsSummary" Style="{StaticResource Hint}" Margin="0,12,0,14"/><Button x:Name="ImportDocs" Content="Copiar o save de Documentos para esta pasta" HorizontalAlignment="Left"/><TextBlock Text="Só copia: o save de Documentos\My Games continua intacto. Se já houver um save aqui, ele vai antes para dados\backups." Style="{StaticResource Hint}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <Grid x:Name="PageLogs" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="REGISTRO E DIAGNÓSTICO" Style="{StaticResource Heading}"/><TextBlock Text="Mensagens da conferência, da preparação e de cada abertura do jogo. O diagnóstico junta num arquivo de texto o que ajuda a investigar um problema (sem o save e sem arquivos do jogo)." Style="{StaticResource Hint}" Grid.Row="1" Margin="0,0,0,20"/><TextBox x:Name="LogText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"/><WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="Diagnose" Content="Gerar diagnóstico" Style="{StaticResource Primary}" Margin="0,0,12,8"/><Button x:Name="CopyLogs" Content="Copiar registro" Margin="0,0,12,8"/><Button x:Name="OpenLogs" Content="Registros do jogo" Margin="0,0,12,8"/><Button x:Name="OpenLauncherLogs" Content="Registros do launcher" Margin="0,0,12,8"/><Button x:Name="OpenCrashes" Content="Relatórios de falha" Margin="0,0,0,8"/></WrapPanel></Grid>
  <ScrollViewer x:Name="PageCredits" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="CRÉDITOS" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="BANJO-TOOIE PT-BR RECOMPILED" FontWeight="Bold" Foreground="#FFD27A" FontSize="19"/>
   <TextBlock Text="Recompilação base do Banjo-Tooie XBLA: iron-jay (banjo_tooie_xbla_recomp)" Margin="0,22,0,10" TextWrapping="Wrap"/>
   <TextBlock Text="Runtime, recompilador e renderização: ReXGlue SDK (BSD-3-Clause, derivado do Xenia)" Margin="0,0,0,10" TextWrapping="Wrap"/>
   <TextBlock Text="Referência de endereços para 60 FPS e alcance de desenho: patches da comunidade do Xenia (illusion, retroben, wedarobi)" Margin="0,0,0,10" TextWrapping="Wrap"/>
   <TextBlock Text="Modelo deste launcher (layout, estilos, configurador e backups): MC_LA_Recompiled, de Roberto Araujo (GPL-3.0-or-later). Este launcher também é GPL-3.0-or-later." Margin="0,0,0,22" TextWrapping="Wrap"/>
   <TextBlock Text="Banjo-Tooie e suas marcas pertencem à Microsoft e à Rare. Esta pasta não traz nenhum arquivo do jogo: o port usa somente a sua própria cópia, neste computador. O programa do port contém código recompilado do jogo: é para uso pessoal; não compartilhe a pasta preparada." Style="{StaticResource Hint}"/><Button x:Name="OpenLicenses" Content="Abrir créditos e licenças" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
 </Grid>
 <Border Grid.Column="1" VerticalAlignment="Bottom" Background="#1C140C" BorderBrush="#33251A" BorderThickness="0,1,0,0" Padding="20,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Escolha a pasta do seu jogo." Foreground="#CDB89B" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="WorkProgress" Grid.Column="1" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#F5B83D" Background="#3A2A1A" BorderThickness="0"/></Grid></Border>
 </Grid>
</Window>
